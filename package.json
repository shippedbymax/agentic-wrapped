{
  "name": "agentic-wrapped",
  "version": "0.1.1",
  "description": "Your year with AI coding agents, wrapped. 100% local.",
  "keywords": ["claude-code", "codex", "wrapped", "ai", "coding-agents", "cli", "usage"],
  "license": "MIT",
  "author": "shippedbymax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shippedbymax/agentic-wrapped.git"
  },
  "homepage": "https://github.com/shippedbymax/agentic-wrapped#readme",
  "bugs": {
    "url": "https://github.com/shippedbymax/agentic-wrapped/issues"
  },
  "type": "module",
  "bin": {
    "agentic-wrapped": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:player && tsup",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.player.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "update-pricing": "tsx scripts/update-pricing.ts",
    "check": "npm run lint && npm run lint:layers && npm run typecheck && npm run test && npm run build",
    "build:player": "tsx scripts/build-player.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "satori": "^0.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^20.17.0",
    "dependency-cruiser": "^16.8.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
